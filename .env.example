# --- Server (Render / local) ---
NODE_ENV=production
PORT=5000
# MongoDB Atlas connection string (include database name, e.g. /nexus)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexus?retryWrites=true&w=majority
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=https://your-app.vercel.app,http://localhost:5173
# Admin account created automatically on boot if missing
ADMIN_EMAIL=admin@nexus.edu
ADMIN_PASSWORD=Admin@12345
# Insert demo events on boot when the events collection is empty
SEED_DEMO_DATA=true
